CHANGE 3 — DbContext: add junction table + configure composite key


public DbSet<Course> Courses { get; set; }
public DbSet<StudentCourse> StudentCourses { get; set; }

// Override OnModelCreating to set COMPOSITE PRIMARY KEY
// Junction table has no single Id — both FKs together = primary key
protected override void OnModelCreating(ModelBuilder modelBuilder)
{
    modelBuilder.Entity<StudentCourse>()
        .HasKey(sc => new { sc.StudentId, sc.CourseId }); // Composite PK
}

CHANGE 4 — Controller: use ThenInclude for nested joins
In StudentController.cs, wherever you have .Include():

// One-to-Many was:
.Include(s => s.Department)

// Many-to-Many becomes:
.Include(s => s.StudentCourses)       // Join to junction table
    .ThenInclude(sc => sc.Course)     // Then join to Course table


    For enrolling a student in a course (POST to junction table):

    // POST: api/studentcourse
// Body: { "studentId": 1, "courseId": 3 }
[HttpPost]
public async Task<IActionResult> Enroll([FromBody] StudentCourse sc)
{
    // Check if already enrolled (avoid duplicate)
    bool exists = _context.StudentCourses
        .Any(x => x.StudentId == sc.StudentId && x.CourseId == sc.CourseId);

    if (exists)
        return BadRequest(new { message = "Already enrolled!" });

    _context.StudentCourses.Add(sc);
    await _context.SaveChangesAsync();
    return Ok(new { message = "Enrolled successfully" });
}

// DELETE: api/studentcourse?studentId=1&courseId=3
[HttpDelete]
public async Task<IActionResult> UnEnroll(int studentId, int courseId)
{
    var record = await _context.StudentCourses
        .FirstOrDefaultAsync(x => x.StudentId == studentId && x.CourseId == courseId);

    if (record == null) return NotFound();

    _context.StudentCourses.Remove(record);
    await _context.SaveChangesAsync();
    return Ok(new { message = "Removed" });
}

