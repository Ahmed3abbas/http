Many-to-Many Example: Student ↔ Course
(A student can enroll in many courses. A course can have many students.)

CHANGE 1 — Add a Junction Model (new file)
Models/StudentCourse.cs
This is the only truly new file. It's the bridge table between the two

// Junction table: sits between Student and Course
// Holds the FK of BOTH tables as a composite key
using System.ComponentModel.DataAnnotations;
using System.ComponentModel.DataAnnotations.Schema;

namespace StudentAPI.Models
{
    public class StudentCourse
    {
        // FK to Students table
        public int StudentId { get; set; }

        // FK to Courses table
        public int CourseId { get; set; }

        // Navigation to Student
        [ForeignKey("StudentId")]
        public Student? Student { get; set; }

        // Navigation to Course
        [ForeignKey("CourseId")]
        public Course? Course { get; set; }
    }
}


